@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h4>@ViewData["Title"]</h4>

<div class="row">
    <div class="col-md-6">
        <hr />
        <p>Your account contains personal data that you have given us. This page allows you to download or deactivate your account.</p>
        <br />
        <section>
            <form id="download-data" asp-page="DownloadPersonalData" method="post" class="form-group">
                <button class="btn btn-primary" type="submit">Download</button>
            </form>
            <br/>
            <p>
                <a id="deactivate" asp-page="DeletePersonalData" class="btn btn-primary">Deactivate</a>
            </p>
            <br/>
        </section>
    </div>

    <div class="col-md-6 col-md-offset-2">
        <section>
            <h4>Purpose of Account Deactivation:</h4>
            <hr />
            <p>
                <strong>Security:</strong> Deactivation can be initiated by the platform or the user as a security measure. It helps prevent unauthorized access to the account if suspicious activity or a breach is suspected. This protects both the user's data and the platform's integrity.
                <br />
                <br />
                <strong>Temporary Suspension:</strong> Users may choose to deactivate their accounts voluntarily when they want to take a break from the platform without permanently deleting their profiles. <strong>It's an irreversible action.</strong>
                <br />
                <br />
                <strong>Privacy:</strong> Some individuals opt for deactivation to enhance their online privacy. By deactivating, they reduce their digital footprint and limit the information available to others.
            </p>
        </section>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}