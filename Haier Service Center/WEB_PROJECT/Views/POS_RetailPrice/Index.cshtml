@model PaginatedList<ServicePlatform.Models.POS_RetailPrice>

@{
	ViewData["Title"] = "Index";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<h3>Index</h3>

<p>
	<a asp-action="Create">Create New</a>
</p>

@using (Html.BeginForm("Index", "POS_RetailPrice", FormMethod.Get))
{
	<div class="row">
		<div class="col-md-3">
			<div class="form-group">
				<label for="CurrentFilter">Search:</label>
				<input type="text" name="CurrentFilter" class="form-control" value="@ViewBag.CurrentFilter" />
			</div>
		</div>
		<div class="col-md-2">
			<div class="form-group">
				<label for="PageSize">Page Size:</label>
				<input type="number" name="PageSize" id="pageSize" class="form-control" value="@ViewBag.PageSize" />
			</div>
		</div>
		<div class="col-md-3 d-flex align-items-end">
			<button type="submit" class="btn btn-primary">Search</button>
			<p class="m-1"> | </p>
			<a asp-action="Index" class="m-1">Back to Full List</a>
		</div>
	</div>
}

<table class="table">
	<thead>
		<tr>
			<th>
				@Html.DisplayNameFor(model => model.First().POS_ItemMaster.ItemName)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.First().Price)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.First().POS_Taxation.HSNCode)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.First().ModifiedDatetime)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.First().IsActive)
			</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>
					@Html.DisplayFor(modelItem => item.POS_ItemMaster.ItemName)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Price)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.POS_Taxation.HSNCode)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.ModifiedDatetime)
				</td>
				<td>
				@*@Html.DisplayFor(modelItem => item.IsActive)*@
 					<input type="checkbox" disabled="disabled" @(item.IsActive.HasValue && item.IsActive.Value ? "checked" : "") />

				</td>
				<td>
					<a asp-action="Edit" asp-route-id="@Encrypt.Encrypt(item.PriceID)">Edit</a> |
					<a asp-action="Details" asp-route-id="@Encrypt.Encrypt(item.PriceID)">Details</a> |
					<a asp-action="Delete" asp-route-id="@Encrypt.Encrypt(item.PriceID)">Delete</a>
				</td>
			</tr>
		}
	</tbody>
</table>

@{
	var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
	var nextDisabled = !Model.HasNextPage ? "disabled" : "";

}

<a asp-action="Index"
   asp-route-sortOrder="@ViewData["CurrentSort"]"
   asp-route-pageNumber="@(Model.PageIndex - 1)"
   asp-route-currentFilter="@ViewData["CurrentFilter"]"
   asp-route-pageSize="@ViewData["PageSize"]"
   class="btn btn-secondary @prevDisabled">
	Previous
</a>

<a asp-action="Index"
   asp-route-sortOrder="@ViewData["CurrentSort"]"
   asp-route-pageNumber="@(Model.PageIndex + 1)"
   asp-route-currentFilter="@ViewData["CurrentFilter"]"
   asp-route-pageSize="@ViewData["PageSize"]"
   class="btn btn-secondary @nextDisabled">
	Next
</a>

@section Scripts {

	<script src="~/js/inputrange.js"></script>
}
