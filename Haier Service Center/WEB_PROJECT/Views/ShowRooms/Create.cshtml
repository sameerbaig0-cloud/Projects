<script>

    window.onload = function () {

        navigator.geolocation.getCurrentPosition(

            function (position) {

                var lat = position.coords.latitude;
                var lng = position.coords.longitude;

                // Set hidden fields
                document.getElementById("Latitude").value = lat;
                document.getElementById("Longitude").value = lng;

                // Show values
                document.getElementById("latText").innerText = lat;
                document.getElementById("lngText").innerText = lng;

                // Create map
                var map = L.map('map').setView([lat, lng], 15);

                // Tile layer
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; OpenStreetMap contributors'
                }).addTo(map);

                // Draggable marker
                var marker = L.marker([lat, lng], {
                    draggable: true
                }).addTo(map)
                  .bindPopup('Your Location')
                  .openPopup();

                // Update when dragging
                marker.on('dragend', function () {

                    var pos = marker.getLatLng();

                    document.getElementById("Latitude").value = pos.lat;
                    document.getElementById("Longitude").value = pos.lng;

                    document.getElementById("latText").innerText = pos.lat;
                    document.getElementById("lngText").innerText = pos.lng;
                });

                // Optional: move marker on map click
                map.on('click', function (e) {

                    marker.setLatLng(e.latlng);

                    document.getElementById("Latitude").value = e.latlng.lat;
                    document.getElementById("Longitude").value = e.latlng.lng;

                    document.getElementById("latText").innerText = e.latlng.lat;
                    document.getElementById("lngText").innerText = e.latlng.lng;
                });

            },

            function (error) {

                alert("Location permission denied or unavailable.");

                console.log(error);
            }

        );

    };

</script>



@section Scripts
{

    <script src="~/lib/jquery/dist/jquery-3.6.0.min.js"></script>
    <script src="~/lib/jquery-select/js/select2.min.js"></script>

    <script>

        $(document).ready(function () {

                    // Initialize Select2
                    $('.select-items').select2({
                        width: '100%',
                        placeholder: '-- Select --',
                        allowClear: true,
                        dropdownParent: $('#showRoommodel')
                    });






                    // STATE -> DISTRICT
                    $("#State").change(function () {

                        var state = $(this).val();

                        $("#District").empty()
                                      .append('<option value="">-- Select District --</option>');

                        $("#City").empty()
                                  .append('<option value="">-- Select City --</option>');

                        if (state !== "") {

                            $.get('/ShowRooms/GetDistrict', { state: state }, function (data) {

                                $.each(data, function (i, district) {

                                    $("#District").append(
                                        $('<option></option>')
                                            .val(district.value)
                                            .html(district.text)
                                    );
                                });
                                $("#District").trigger("change.select2");

                            });
                        }

                    });


                // DISTRICT -> CITY
                $("#District").change(function () {

                    var state = $("#State").val();
                    var district = $("#District").val();

                    $("#City").empty()
                              .append('<option value="">-- Select City --</option>');

                    if (district !== "") {

                        $.get('/ShowRooms/GetCity',
                            {
                                state: state,
                                district: district
                            },
                            function (data) {

                                $.each(data, function (i, city) {

                                    $("#City").append(
                                        $('<option></option>')
                                            .val(city.value)
                                            .html(city.text)
                                    );

                                });

                                $("#City").trigger("change.select2");

                            });

                    }
                });


              // CITY -> ZIP CODE
                $("#City").change(function () {

                    var state = $("#State").val();
                    var district = $("#District").val();
                    var city = $("#City").val();

                    $("#ZipCode").empty()
                              .append('<option value="">-- Select Zip Code --</option>');

                    if (district !== "") {

                        $.get('/ShowRooms/GetZipCode',
                            {
                                state: state,
                                district: district,
                                city: city
                            },
                            function (data) {

                                $.each(data, function (i, zipcode) {

                                    $("#ZipCode").append(
                                        $('<option></option>')
                                            .val(zipcode.value)
                                            .html(zipcode.text)
                                    );

                                });

                                $("#ZipCode").trigger("change.select2");

                            });

                    }
                });



        });

    </script>
