@model ServicePlatform.Models.POS_InvoiceModel

@* @{
	Layout = null;
} *@

<style>
	/* Add CSS styles for the table */
	*, body {
		font-family: Tahoma;
		font-size: 11px;
		margin: 0;
		padding: 0;
	}

	.invoice_header p {
		margin-top: 0;
		margin-bottom: 1px;
	}

	.invoice_body {
		width: 420px;
		margin-left: 1px;
		margin-right: 1px;
	}

	.invoice-table td:nth-child(1) {
		max-width: 70px;
	}

	.invoice-table td:nth-child(2) {
		max-width: 70px;
	}

	.invoice-table td:nth-child(3) {
		max-width: 70px;
	}

	.invoice-table td:nth-child(4) {
		max-width: 50px;
	}

	.invoice-table td:nth-child(5) {
		max-width: 50px;
	}


	.invoice_container {
		border: 0.5px solid grey;
	}

	.invoice_name {
		text-align: center;
	}

	.companyclass th {
		border: 0.5px solid grey;
		text-align: left;
		width: 100%;
	}

		.companyclass th:nth-child(1) {
			width: 210px;
		}


		.companyclass th:nth-child(2) {
			width: 210px;
		}

	.companyclass_2 th {
		border: 0.5px solid grey;
		text-align: left;
		width: 100%;
	}

		.companyclass_2 th:nth-child(1) {
			width: 210px;
		}


		.companyclass_2 th:nth-child(2) {
			width: 210px;
		}

	.companyclass_2 p {
		margin: 0;
		padding-top: 2px;
		padding-bottom: 2px;
	}

	.paymentclass tbody tr td {
		border: 0.5px solid grey;
		text-align: left;
		width: 100%;
		padding: 5px padding-bottom: 2px
	}

	.paymentclass td:nth-child(1) {
		width: 90px;
	}

	.paymentclass td:nth-child(2) {
		width: 60px;
	}


	.invoiceNoclass {
		border: 0.5px solid grey;
		width: 256px;
		float: left;
		text-align: left;
	}

	.invoice_header {
		text-align: center;
		margin-bottom: 5px;
		justify-content: space-between;
	}


	.invoice-table {
		width: 100%;
	}


		.invoice-table thead tr {
			text-align: center
		}


		.invoice-table tbody tr {
			border: 0.5px solid grey;
			height: 15px;
		}

			.invoice-table tbody tr td {
				text-align: center;
			}

	.invoice-GST {
		width: 100%;
	}


		.invoice-GST tbody tr td {
			border: 0.5px solid grey;
			padding: 5px padding-bottom: 0px;
			text-align: center;
			vertical-align: -webkit-baseline-middle;
		}

		.invoice-GST th {
			border: 0.5px solid grey;
			padding: 5px padding-bottom: 2px;
			text-align: center;
			vertical-align: -webkit-baseline-middle;
		}

	.invoice_signature {
		padding: 0;
		margin: 0;
		width: 100%;
		text-align: right;
	}

		.invoice_signature tr p {
			text-align: left;
			margin-bottom: 0px;
		}


	.invoice_signature_companyname {
		padding-top: 20px;
		padding-bottom: 20px;
	}


	.invoice_signature_acknowledgement {
		padding-top: 15px;
		width: 100%;
	}


		.invoice_signature_acknowledgement p {
			text-align-last: left;
		}

	.printbutton {
		display: none;
	}

	header, footer {
		display: none;
	}

</style>

<link href="~/css/pos_invoiceprinting.css" rel="stylesheet" type="text/css" media="print" />

<body class="invoice_body">
	<div>
		<div class="invoice_container">
			<div class="invoice_header">
				<div class="invoice_name"><h8>TAX INVOICE</h8></div>
				<div class="left-column">
					<table class="companyclass">
						<tr>
							<th>
								<p>@Model.CompanyInfo.CompanyName</p>
								<p>Retail Store</p>
								<p>@Model.POS_RetailStore.StoreAddress1 &comma; @Model.POS_RetailStore.StoreAddress2 &comma; @Model.POS_RetailStore.StoreCity &comma; @Model.POS_RetailStore.StorePinCode &comma; @Model.POS_RetailStore.StoreDistrict &comma; @Model.POS_RetailStore.StoreState &comma; @Model.POS_RetailStore.StoreCountry</p>
							</th>
							<th>
								<div class="right-column">
									<p>Registered Office & Factory</p>
									<p>@Model.CompanyInfo.Address1 &comma; @Model.CompanyInfo.Address2 &comma; @Model.CompanyInfo.Address3 </p>
								</div>
							</th>
						</tr>
					</table>
				</div>
				<div class="left-column">
					<table class="companyclass_2">
						<tr>
							<th>
								<p>GSTIN: @Model.CompanyInfo.GSTIN</p>
								<p>Invoice Date: @Model.POS_Invoice.InvoiceDate.ToString("dd MMM yyyy")</p>
								<p>Invoice No: @Model.POS_Invoice.InvoiceID</p>
							</th>
							<th>
								<div class="right-column">
									<p>Customer  : @Model.POS_Customer.FirstName</p>
									<p>Address   : @Model.POS_Customer.Address</p>
									<p>Mobile No : @Model.POS_Customer.Phone</p>
									<p>Email ID  : @Model.POS_Customer.Email</p>
								</div>
							</th>
						</tr>
					</table>
				</div>
			</div>

			<table class="invoice-table">
				<thead>
					<tr>
						<th>Article</th>
						<th>Description</th>
						<th>Brand</th>
						<th>UOM</th>
						<th>Qty</th>
						<th>Size</th>
						<th>MRP</th>
						<th>Total</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var item in Model.POS_InvoiceItem)
					{
						<tr>
							<td>@item.ArticleNo</td>
							<td>@item.ArticleMaster.ArticleName</td>
							<td>@item.ArticleMaster.ArticleBrandModel.ArticleBrand</td>
							@* <td>@item.UOM</td> *@
							<td>Pairs</td>
							<td>@item.Quantity</td>
							<td>@item.Size</td>
							<td>₹ @item.UnitPrice.ToString("0.00")</td>
							<td>₹ @item.UnitPrice.ToString("0.00")</td>
						</tr>
					}
					<tr>
						<td> </td>
						<td> </td>
						<td> </td>
						<td> </td>
						<td> </td>
						<td> </td>
						<td> </td>
						<td> </td>
					</tr>


				</tbody>
			</table>

			<div style="display: inline;" class="row">
				<table style="width: 59%; float: left; border: none;">
					<tbody>
						<tr>
							<td style="text-align: left;">Amount Chargeable (In Words)</td>
						</tr>
						<tr>
							<td style="text-align: left;">@Model.AmountInWords</td>
						</tr>
						<tr>
							<td style="text-align: left;"><p>Whether the tax is payable on Reverse charge basis: No</p></td>
						</tr>
					</tbody>
				</table>
				<table class="paymentclass" style="width: 40%; float: right;">
					<tbody>
						<tr>
							<td style="text-align: right;">Payment Mode</td>
							<td style="text-align: right;">@Model.POS_PaymentType.Description</td>
						</tr>
						<tr>
							<td style="text-align: right;">Sub Total</td>
							<td style="text-align: right;">@Model.SubTotalValue</td>

						</tr>
						<tr>
							<td style="text-align: right;">Discount</td>
							<td style="text-align: right;">@Model.DiscountValue</td>

						</tr>
						<tr>
							<td style="text-align: right;">Total:</td>
							<td style="text-align: right;">@Model.POS_Invoice.TotalAmount</td>
						</tr>
						<tr>
						</tr>
					</tbody>
				</table>
			</div>

			<div style="width: 100%; line-height: 20px;">
				<b>GST Details</b>
			</div>

			<div>
				<table class="invoice-GST">
					<thead>
						<tr>
							<th>HSN Code</th>
							<th>HSN Desc</th>
							<th>Taxable Value</th>
							<th>CGST%</th>
							<th>CGST Value</th>
							<th>SGST%</th>
							<th>SGT Value</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var tax in Model.TaxationSummaryViewModels)
						{
							<tr>
								<td>@tax.HSNCode</td>
								<td>@tax.HSNDesc</td>
								<td>@tax.TaxableValue</td>
								<td>@tax.CGSTPercent</td>
								<td>@tax.CGSTValue</td>
								<td>@tax.SGSTPercent</td>
								<td>@tax.SGSTValue</td>
							</tr>
						}
					</tbody>
				</table>
				<div style="display: inline;" class="desc">
					<table class="invoice_signature">
						<tbody>
							<tr>
								<td colspan="2" class="invoice_signature_companyname">For @Model.CompanyInfo.CompanyName</td>
							</tr>
							<tr>
								<td style="text-align: left;">You were served by : @Model.ApplicationUser.FirstName </td>
								<td style="text-align: center;">Authorised Signatory</td>
							</tr>
							<tr>
								<td>
									@foreach (var infos in Model.AdditionalInformation)
									{
										<p>@infos</p>
									}
								</td>
							</tr>
							<tr>
								<td class="invoice_signature_acknowledgement">
									@foreach (var acknow in Model.Acknowledgements)
									{
										<p>@acknow</p>
									}
								</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>
		<script>

			// Call printInvoice function when the page loads
			window.onload = function () {
				printInvoice();
			};


			function printInvoice() {
				var printContents = document.querySelector('.invoice_body').innerHTML;
				var originalContents = document.body.innerHTML;
				document.body.innerHTML = printContents;
				console.log(printContents);


				// Remove print button from printed content
				var printButton = document.querySelector('.printbutton');
				if (printButton) {
					printButton.remove();
				}

				// Hide footer when printing
				window.onbeforeprint = function () {
					var footer = document.querySelector('.footer');
					footer.style.display = 'none';
					var header = document.querySelector('header');
					header.style.display = 'none';
				}


				window.print();

				// // Show footer after printing (optional)
				// window.onafterprint = function () {
				// 	var footer = document.querySelector('.footer');
				// 	footer.style.display = 'block';
				// 	var header = document.querySelector('header');
				// 	header.style.display = 'block';
				// }


				//document.body.innerHTML = originalContents;
			}
		</script>

		<button class="printbutton" onclick="printInvoice()">Print Invoice</button>

	</div>
</body>
</html>

