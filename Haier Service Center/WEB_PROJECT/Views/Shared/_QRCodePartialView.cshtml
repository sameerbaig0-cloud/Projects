@model List<OrderMasterTrackingCodeQRCode>



<style type="text/css">

	.print-container table tr, td {
		border-collapse: collapse;
		text-align: left;
		margin: 0px;
		font-weight: 600;
		font-family: Calibri;
		font-size: 11px;
		line-height: 0px;
	}


	.qrCodeImage {
		position: relative;
		max-width: 70px;
		max-height: 70px;
		margin: 0px;
		padding: 0px;
	}

</style>



@if (Model != null)
{
	@foreach (var qrCodeViewModel in Model)
	{

		var j = 2;
		@for (int i = 1; i <= j; i++)
		{
			<div class="print-container">
				<table id="printoutput_@qrCodeViewModel.OrderNo">
					<tbody>
						<tr>
							<td rowspan="5" class="qrCodeImage">
								<img src="@qrCodeViewModel.QRCodeData" alt="QR Code" class="qrCodeImage" />
							</td>
							<td class="print-data" style="padding-top: 2px;">@qrCodeViewModel.OrderNo</td>
						</tr>
						<tr>
							<td colspan="2" class="print-data">@qrCodeViewModel.Article</td>
						</tr>
						<tr>
							<td class="print-data" style="width: 10px;">@qrCodeViewModel.Size</td>
							<td class="print-data" style="width: 15px; padding-right: 5px;">@qrCodeViewModel.Gender</td>
						</tr>
						<tr>
							<td colspan="2" class="print-data" style="padding-bottom: 2px;">@qrCodeViewModel.StampingNo</td>
						</tr>
					</tbody>
				</table>
			</div>
		}

	}
}


