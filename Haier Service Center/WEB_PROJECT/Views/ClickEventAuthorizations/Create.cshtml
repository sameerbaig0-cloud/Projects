@model ServicePlatform.Models.ClickEventAuthorization

@{
	ViewData["Title"] = "Create";
	Layout = "~/Views/Shared/_Layout.cshtml";
}


@*Load CSS for Editable Select - BEGIN *@
<link href="~/lib/jquery-select/css/select2.min.css" rel="stylesheet" />
@*Load CSS for Editable Select - END *@


<h1>Create</h1>


<h4>Click Event Authorization</h4>
<hr />


<div class="row">
	<div class="col-md-4">
		<form asp-action="Create">
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>
			<div class="form-group">
				<label asp-for="UserId" class="control-label"></label>
				<select asp-for="UserId" class="select-items" class="form-control" asp-items="ViewBag.UserId">
					<option value="" disabled selected>--Select User--</option>
				</select>
			</div>
			<div class="form-group">
				<label asp-for="ControllerName" class="control-label"></label>
				<select asp-for="ControllerName" class="select-items" class="form-control" id="controllerNameSelect" asp-items="ViewBag.ControllerName">
					<option value="" disabled selected>--Select Controller--</option>
				</select>
				<span asp-validation-for="ControllerName" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="ActionName" class="control-label"></label>
				<select asp-for="ActionName" class="select-items" class="form-control" id="actionNameSelect" disabled>
					<option value="">Select Action</option>
					<!-- This dropdown will be populated based on the selected controller name -->
				</select>
				<span asp-validation-for="ActionName" class="text-danger"></span>
			</div>
			<div class="form-group">
				<input type="submit" value="Create" class="btn btn-primary" />
			</div>
		</form>
	</div>
</div>


<div>
	<a asp-action="Index">Back to List</a>
</div>



@section Scripts {
	@{
		//await Html.RenderPartialAsync("_ValidationScriptsPartial");


		@*Load CSS for Editable Select - BEGIN *@
		<script src="~/lib/jquery-select/js/select2.min.js"></script>
		@*Load CSS for Editable Select - END *@

		@*/* SCRIPT FOR DROPDOWNLIST - BEGINS */*@
		<script>

			//jQuery.noConflict(true);


			$(function () {
				$('.select-items').select2({
					dropdownParent: $('#userPageAuthorizationmodel')
				});

				$('.select-items').select2({ width: '100%' });
			});

		</script>
		@*/* SCRIPT FOR DROPDOWNLIST - ENDS */*@



		<script>
			$(function () {
				$('#controllerNameSelect').change(function () {
					var controllerName = $(this).val();
					$('#actionNameSelect').prop('disabled', true).empty();
					if (controllerName) {
						// Call an action method to get action names for the selected controller
						$.get('/ClickEventAuthorizations/GetActionNames', { controllerName: controllerName }, function (data) {
							if (data) {
								//alert(controllerName);
								$.each(data, function (index, item) {
									$('#actionNameSelect').append($('<option>').text(item).attr('value', item));
								});
								$('#actionNameSelect').prop('disabled', false);
							}
						});
					}
				});
			});
		</script>



	}
}

