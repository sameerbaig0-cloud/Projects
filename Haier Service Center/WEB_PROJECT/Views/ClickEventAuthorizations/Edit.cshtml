        <script>
            $(function () {

                function loadActions(controllerName, selectedAction) {
                    $('#actionNameSelect').prop('disabled', true).empty();

                    if (controllerName) {
                        $.get('/ClickEventAuthorizations/GetActionNames',
                            { controllerName: controllerName },
                            function (data) {

                                $.each(data, function (index, item) {
                                    var option = $('<option>')
                                        .val(item)
                                        .text(item);

                                    if (item === selectedAction) {
                                        option.prop('selected', true);
                                    }

                                    $('#actionNameSelect').append(option);
                                });

                                $('#actionNameSelect').prop('disabled', false);
                            });
                    }
                }

                // On controller change
                $('#controllerNameSelect').change(function () {
                    loadActions($(this).val(), null);
                });

                // On page load (Edit page)
                var controllerName = $('#controllerNameSelect').val();
                var selectedAction = $('#actionNameSelect').data('selected');

                if (controllerName) {
                    loadActions(controllerName, selectedAction);
                }
            });

        </script>

    }
}
