@model ServicePlatform.Models.ClickEventAuthorization

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*Load CSS for Editable Select - BEGIN *@
<link href="~/lib/jquery-select/css/select2.min.css" rel="stylesheet" />
@*Load CSS for Editable Select - END *@


<h1>Edit</h1>

<h4>ClickEventAuthorization</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="UserId" class="control-label"></label>
                <select asp-for="UserId" class="select-items" class="form-control" asp-items="ViewBag.UserId">
                    <option value="" disabled selected>--Select User--</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="ControllerName" class="control-label"></label>
                <select asp-for="ControllerName" class="select-items" class="form-control" id="controllerNameSelect" asp-items="ViewBag.ControllerName">
                    <option value="" disabled selected>--Select Controller--</option>
                </select>
                <span asp-validation-for="ControllerName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ActionName" class="control-label"></label>
                <select asp-for="ActionName" class="select-items" class="form-control" id="actionNameSelect" disabled>
                    <option value="">Select Action</option>
                    <!-- This dropdown will be populated based on the selected controller name -->
                </select>
                <span asp-validation-for="ActionName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>





